{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Pp]review|[Ss]canner|[Ff]etcher|facebookexternalhit|WhatsApp|Pinterest|Mastodon|Embedly|Iframely|Slack|[Oo]pen[Gg]raph).*"
        }
      ],
      "destination": "/api/og?kind=home"
    },
    {
      "source": "/presidentielle-2027",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Pp]review|[Ss]canner|[Ff]etcher|facebookexternalhit|WhatsApp|Pinterest|Mastodon|Embedly|Iframely|Slack|[Oo]pen[Gg]raph).*"
        }
      ],
      "destination": "/api/og?kind=presidentielle"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Pp]review|[Ss]canner|[Ff]etcher|facebookexternalhit|WhatsApp|Pinterest|Mastodon|Embedly|Iframely|Slack|[Oo]pen[Gg]raph).*"
        }
      ],
      "destination": "/api/og?kind=blog"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Pp]review|[Ss]canner|[Ff]etcher|facebookexternalhit|WhatsApp|Pinterest|Mastodon|Embedly|Iframely|Slack|[Oo]pen[Gg]raph).*"
        }
      ],
      "destination": "/api/og?kind=article&id=:slug"
    },
    {
      "source": "/market/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Pp]review|[Ss]canner|[Ff]etcher|facebookexternalhit|WhatsApp|Pinterest|Mastodon|Embedly|Iframely|Slack|[Oo]pen[Gg]raph).*"
        }
      ],
      "destination": "/api/og?kind=market&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/sitemap?type=pages"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap?type=blog"
    },
    {
      "source": "/sitemap-markets.xml",
      "destination": "/api/sitemap?type=markets"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/og-image.js": {
      "includeFiles": "api/_fonts/**",
      "maxDuration": 15
    }
  }
}
