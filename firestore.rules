rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Marchés ─────────────────────────────────────────────────────────────
    // Lecture publique. Écriture réservée aux admins (champ isAdmin sur l'user).
    match /markets/{marketId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();

      match /options/{optionId} {
        allow read: if true;
        allow write: if request.auth != null && isAdmin();
      }

      match /priceHistory/{entryId} {
        allow read: if true;
        // Écrit uniquement par les Cloud Functions (Admin SDK, qui ignore ces
        // règles). Jamais depuis le client : sinon n'importe qui pourrait
        // falsifier les courbes de prix.
        allow write: if false;
      }
    }

    // ── Soumissions de marchés ───────────────────────────────────────────────
    // Un user peut créer une soumission et relire les siennes.
    // Seul un admin peut modifier/supprimer.
    match /submissions/{submissionId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ── Paris ────────────────────────────────────────────────────────────────
    // Lecture : publique, car l'historique de paris est affiché sur les profils
    // publics (page Profil, accessible depuis le classement).
    // Écriture : jamais depuis le client. Les paris sont créés uniquement par
    // les Cloud Functions (placeBet, sellShares...). resolveMarket s'appuie sur
    // cette collection pour distribuer les gains : un pari forgé côté client
    // permettrait de toucher des gains indus.
    match /bets/{betId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Positions (compteur de parts détenues) ───────────────────────────────
    // Lecture par le propriétaire uniquement, écriture jamais depuis le client :
    // les Cloud Functions de vente se fient au nombre de parts stocké ici, un
    // client qui pourrait l'éditer pourrait revendre des parts qu'il n'a pas.
    // On s'appuie sur le champ userId du document (et non sur l'ID) : une
    // requête where("userId", "==", uid) n'est autorisée que si la règle porte
    // sur ce même champ.
    match /positions/{positionId} {
      // Le test sur l'ID passe d'abord : il permet d'écouter un document qui
      // n'existe pas encore (resource est alors null). Le test sur le champ
      // userId sert aux requêtes where("userId", "==", uid).
      allow read: if request.auth != null &&
        (positionId.matches(request.auth.uid + '_.*') ||
         resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ── Articles du blog ─────────────────────────────────────────────────────
    // Lecture publique des articles publiés.
    // Admins peuvent lire tous les articles (brouillons inclus).
    // Création, modification et suppression réservées aux admins.
    match /articles/{articleId} {
      allow read: if resource.data.status == "published" ||
                     (request.auth != null && isAdmin());
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // ── Utilisateurs ─────────────────────────────────────────────────────────
    // Lecture publique (leaderboard, profils).
    // Le client ne peut jamais toucher balance, isAdmin, totalBets, etc. :
    //  - création : uniquement son propre document, avec exactement les champs
    //    initiaux posés par AuthContext (balance 1000, totalBets 0, pas d'isAdmin)
    //  - modification : uniquement pseudo, bio et avatarUrl
    // Les Cloud Functions (Admin SDK) gèrent tout le reste.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'avatarUrl', 'balance', 'totalBets', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.balance == 1000
        && request.resource.data.totalBets == 0;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['pseudo', 'bio', 'avatarUrl']);
      allow delete: if false;
    }

    // ── Notifications ────────────────────────────────────────────────────────
    // Lecture par le destinataire, écriture par les Cloud Functions uniquement.
    // Le destinataire peut seulement la marquer comme lue.
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // ── Suivi de marchés ─────────────────────────────────────────────────────
    // Document follows/{uid}_{marketId}. Chacun gère uniquement ses suivis ;
    // les Cloud Functions les lisent pour envoyer les alertes.
    match /follows/{followId} {
      allow read: if request.auth != null &&
        (followId.matches(request.auth.uid + '_.*') ||
         resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'marketId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.marketId;
      allow delete: if request.auth != null && followId.matches(request.auth.uid + '_.*');
      allow update: if false;
    }

    // ── Commentaires (sous les marchés et les articles) ──────────────────────
    // Lecture publique. Création par un utilisateur connecté, à son nom, avec un
    // texte de 1 à 500 caractères. Suppression par l'auteur ou un admin.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['targetKey', 'userId', 'pseudo', 'avatarUrl', 'text', 'side', 'parentId', 'createdAt'])
        && request.resource.data.keys().hasAll(['targetKey', 'userId', 'pseudo', 'text', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.targetKey is string
        && request.resource.data.targetKey.size() <= 200
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Signalements de commentaires ─────────────────────────────────────────
    // Un utilisateur ne peut signaler qu'une fois le même commentaire.
    // Lecture et suppression réservées aux admins.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['commentId', 'userId', 'reason', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && reportId == request.resource.data.commentId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read, delete: if request.auth != null && isAdmin();
      allow update: if false;
    }

    // ── Données publiques calculées (ex. meta/movers) ────────────────────────
    // Écrites par les Cloud Functions uniquement.
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Fonction helper ──────────────────────────────────────────────────────
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
